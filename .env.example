# SQLite is the default. A postgresql:// URL uses prisma/postgres. See POSTGRES_PATH.md.
DATABASE_URL="file:./dev.db"
# Unset on a public server. Set to 1 only to show the Fill demo block on a production build.
# NORTHSTAR_SHOW_DEMO=1
# Unset unless a reverse proxy overwrites the client address headers.
# TRUST_PROXY=1
# Production sends mail only when both are set. No paid mail service is required.
# SMTP_URL="smtp://user:password@smtp.example:587"
# MAIL_FROM="Northstar <mail@example.com>"
# Development and tests write messages here when SMTP is unset. Production ignores this file.
# MAIL_OUTBOX=".mail/outbox.jsonl"
# smtp, outbox, or off. Unset uses SMTP when it is complete, otherwise the outbox outside production.
# MAIL_TRANSPORT=
